 "nodes": [
  {
   "nodeID": "7_167778512186880985",
   "text": "asylum seekers coming from a safe country shouldn't be allowed into UK",
   "type": "I"
  },
  {
   "nodeID": "8_167778512186880985",
   "text": "AudienceMember 20230302QT15: Mr Jenrick talked about asylum seekers coming from a safe country, that they shouldn't be allowed",
   "type": "L"
  },
  {
   "nodeID": "10_167778512186880985",
   "text": "Anon: AudienceMember 20230302QT15: Mr Jenrick talked about asylum seekers coming from a safe country, that they shouldn't be allowed",
   "type": "L"
  },
  {
   "nodeID": "12_167778512186880985",
   "text": "Robert Jenrick: asylum seekers coming from a safe country, they shouldn't be allowed",
   "type": "L"
  },
  {
   "nodeID": "14_167778512186880985",
   "text": "Anon: Robert Jenrick: Mr Jenrick talked about asylum seekers coming from a safe country, that they shouldn't be allowed",
   "type": "L"
  },
  {
   "nodeID": "24_167778512186880985",
   "text": "xxx about the people from Ukraine, around which there are safe countries as well",
   "type": "I"
  },
  {
   "nodeID": "25_167778512186880985",
   "text": "AudienceMember 20230302QT15: what about the people from Ukraine, there are safe countries around there as well",
   "type": "L"
  },
  {
   "nodeID": "27_167778512186880985",
   "text": "Anon: AudienceMember 20230302QT15: what about the people from Ukraine, there are safe countries around there as well",
   "type": "L"
  },
  {
   "nodeID": "29_167778512186880985",
   "text": "Default Transition",
   "type": "TA"
  },
  {
   "nodeID": "30_167778512186880985",
   "text": "AudienceMember 20230302QT15 is not suggesting that Ukraine is safe",
   "type": "I"
  },
  {
   "nodeID": "31_167778512186880985",
   "text": "Fiona Bruce: you\u2019re not suggesting that Ukraine is safe",
   "type": "L"
  },
  {
   "nodeID": "33_167778512186880985",
   "text": "Anon: Fiona Bruce: you\u2019re not suggesting that Ukraine is safe",
   "type": "L"
  },
  {
   "nodeID": "35_167778512186880985",
   "text": "Default Transition",
   "type": "TA"
  },
  {
   "nodeID": "36_167778512186880985",
   "text": "AudienceMember 20230302QT15 is suggesting that Ukrainians could go to countries near them",
   "type": "I"
  },
  {
   "nodeID": "37_167778512186880985",
   "text": "Fiona Bruce: they could go to countries near them",
   "type": "L"
  },
  {
   "nodeID": "39_167778512186880985",
   "text": "Anon: Fiona Bruce: they could go to countries near them",
   "type": "L"
  },
  {
   "nodeID": "43_167778512186880985",
   "text": "Default Transition",
   "type": "TA"
  },
  {
   "nodeID": "47_167778512186880985",
   "text": "AudienceMember 20230302QT16: Yes",
   "type": "L"
  },
  {
   "nodeID": "49_167778512186880985",
   "text": "Anon: AudienceMember 20230302QT16: Yes",
   "type": "L"
  },
  {
   "nodeID": "51_167778512186880985",
   "text": "Default Transition",
   "type": "TA"
  },
  {
   "nodeID": "53_167778512186880985",
   "text": "Ukrainians are going to countries near them in a large part as well",
   "type": "I"
  },
  {
   "nodeID": "54_167778512186880985",
   "text": "Fiona Bruce: Which of course they are doing in a large part as well",
   "type": "L"
  },
  {
   "nodeID": "56_167778512186880985",
   "text": "Anon: Fiona Bruce: Which of course they are doing in a large part as well",
   "type": "L"
  },
  {
   "nodeID": "59_167778512186880985",
   "text": "government don\u2019t want to let more people come to the UK in small boats",
   "type": "I"
  },
  {
   "nodeID": "60_167778512186880985",
   "text": "Fiona Bruce: you don\u2019t want to",
   "type": "L"
  },
  {
   "nodeID": "62_167778512186880985",
   "text": "Anon: Fiona Bruce: you don\u2019t want to",
   "type": "L"
  },
  {
   "nodeID": "64_167778512186880985",
   "text": "Default Transition",
   "type": "TA"
  },
  {
   "nodeID": "68_167778512186880985",
   "text": "more people are coming across in small boats",
   "type": "I"
  },
  {
   "nodeID": "69_167778512186880985",
   "text": "Fiona Bruce: more people are coming across in small boats",
