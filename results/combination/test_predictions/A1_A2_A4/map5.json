  {
   "nodeID": "2_167596854281677896",
   "text": "it would or would not be an idea for the whole of the public sector to get a pay rise all at the same time",
   "type": "I"
  },
  {
   "nodeID": "3_167596854281677896",
   "text": "AudienceMember 20230209QT09: Would it not be an idea for the whole of the public sector to get a pay rise all at the same time",
   "type": "L"
  },
  {
   "nodeID": "5_167596854281677896",
   "text": "Jordan: AudienceMember 20230209QT09: Would it not be an idea for the whole of the public sector to get a pay rise all at the same time",
   "type": "L"
  },
  {
   "nodeID": "7_167596854281677896",
   "text": "government can give the public sector a pay rise",
   "type": "I"
  },
  {
   "nodeID": "8_167596854281677896",
   "text": "AudienceMember 20230209QT09: government can give them a pay rise",
   "type": "L"
  },
  {
   "nodeID": "10_167596854281677896",
   "text": "Jordan: AudienceMember 20230209QT09: government can give them a pay rise",
   "type": "L"
  },
  {
   "nodeID": "12_167596854281677896",
   "text": "government are the public sector",
   "type": "I"
  },
  {
   "nodeID": "13_167596854281677896",
   "text": "AudienceMember 20230209QT09: they're the public sector",
   "type": "L"
  },
  {
   "nodeID": "15_167596854281677896",
   "text": "Jordan: AudienceMember 20230209QT09: they're the public sector",
   "type": "L"
  },
  {
   "nodeID": "17_167596854281677896",
   "text": "the rest of the public sector should get a pay rise too",
   "type": "I"
  },
  {
