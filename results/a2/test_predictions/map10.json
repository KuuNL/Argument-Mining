 "nodes": [
  {
   "nodeID": "2_168141153402989746",
   "text": "right here in Wales, Labour has left us with the longest hospital waiting lists in the whole of the United Kingdom",
   "type": "I"
  },
  {
   "nodeID": "3_168141153402989746",
   "text": "David Davies: right here in Wales, you\u2019ve left us with the longest hospital waiting lists in the whole of the United Kingdom",
   "type": "L"
  },
  {
   "nodeID": "5_168141153402989746",
   "text": "Tuuli: David Davies: right here in Wales, you\u2019ve left us with the longest hospital waiting lists in the whole of the United Kingdom",
   "type": "L"
  },
  {
   "nodeID": "7_168141153402989746",
   "text": "Labour has left us in Wales with the worst educational outcomes in the United Kingdom",
   "type": "I"
  },
  {
   "nodeID": "8_168141153402989746",
   "text": "David Davies: the worst educational outcomes in the United Kingdom",
   "type": "L"
  },
  {
   "nodeID": "10_168141153402989746",
   "text": "Tuuli: David Davies: the worst educational outcomes in the United Kingdom",
   "type": "L"
  },
  {
   "nodeID": "12_168141153402989746",
   "text": "Labour has left us in Wales with an economy minister who\u2019s admitted that he doesn\u2019t know how to run the economy",
   "type": "I"
  },
  {
   "nodeID": "13_168141153402989746",
   "text": "David Davies: an economy minister who\u2019s admitted that he doesn\u2019t know how to run the economy",
   "type": "L"
  },
  {
   "nodeID": "15_168141153402989746",
   "text": "Tuuli: David Davies: an economy minister who\u2019s admitted that he doesn\u2019t know how to run the economy",
   "type": "L"
  },
  {
   "nodeID": "17_168141153402989746",
   "text": "Labour has left us in Wales with no roads being built",
   "type": "I"
  },
  {
   "nodeID": "18_168141153402989746",
   "text": "David Davies: no roads being built",
   "type": "L"
  },
  {
   "nodeID": "20_168141153402989746",
   "text": "Tuuli: David Davies: no roads being built",
   "type": "L"
  },
  {
   "nodeID": "22_168141153402989746",
   "text": "Labour has left us in Wales with \u00a3100 million being spent on a whole load of extra Welsh Assembly members",
   "type": "I"
  },
  {
   "nodeID": "23_168141153402989746",
   "text": "David Davies: \u00a3100 million being spent on a whole load of extra Welsh Assembly members",
   "type": "L"
  },
  {
   "nodeID": "25_168141153402989746",
   "text": "Tuuli: David Davies: \u00a3100 million being spent on a whole load of extra Welsh Assembly members",
   "type": "L"
  },
  {
   "nodeID": "27_168141153402989746",
   "text": "Labour is even trying to ban meal deals at \u00a33.50",
   "type": "I"
  },
  {
   "nodeID": "28_168141153402989746",
   "text": "David Davies: you're even trying to ban meal deals at \u00a33.50",
   "type": "L"
  },
  {
   "nodeID": "30_168141153402989746",
   "text": "Tuuli: David Davies: you're even trying to ban meal deals at \u00a33.50",
   "type": "L"
  },
  {
   "nodeID": "37_168141153402989746",
   "text": "Labour is an absolute disgrace",
   "type": "I"
  },
  {
   "nodeID": "38_168141153402989746",
   "text": "David Davies: You\u2019re an absolute disgrace",
   "type": "L"
  },
  {
   "nodeID": "40_168141153402989746",
   "text": "Tuuli: David Davies: You\u2019re an absolute disgrace",
   "type": "L"
  },
  {
   "nodeID": "42_168141153402989746",
   "text": "even meal deals being banned is what\u2019s in store for us in Wales",
   "type": "I"
  },
  {
   "nodeID": "43_168141153402989746",
   "text": "David Davies: this is what\u2019s in store for us",
   "type": "L"
  },
  {
   "nodeID": "45_168141153402989746",
   "text": "Tuuli: David Davies: this is what\u2019s in store for us",
   "type": "L"
  },
  {
   "nodeID": "47_168141153402989746",
   "text": "Labour gets elected",
   "type": "I"
  },
  {
   "nodeID": "48_168141153402989746",
   "text": "David Davies: Labour get elected",
   "type": "L"
  },
  {
   "nodeID": "50_168141153402989746",
   "text": "Tuuli: David Davies: Labour get elected",
   "type": "L"
  },
  {
   "nodeID": "53_168141153402989746",
