   "type": "TA"
  },
  {
   "nodeID": "82_168141153402989746",
   "text": "nobody\u2019s going to be allowed to go out and get a meal deal",
   "type": "I"
  },
  {
   "nodeID": "83_168141153402989746",
   "text": "David Davies: nobody\u2019s going to be allowed to go out and get a meal deal",
   "type": "L"
  },
  {
   "nodeID": "85_168141153402989746",
   "text": "Tuuli: David Davies: nobody\u2019s going to be allowed to go out and get a meal deal",
   "type": "L"
  },
  {
   "nodeID": "87_168141153402989746",
   "text": "only those amongst the extra Assembly members who\u2019ll be able to have a full slap-up English breakfast for \u00a33.50 in the Senate are going to be allowed to go out and get a meal deal",
   "type": "I"
