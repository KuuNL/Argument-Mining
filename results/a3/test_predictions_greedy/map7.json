  {
   "nodeID": "72_168019561412742010",
   "text": "every income being \u00a310,000 better off is the sort of economic growth you\u2019d get in the past under the Labour government in the UK",
   "type": "I"
  },
  {
   "nodeID": "73_168019561412742010",
   "text": "Thangam Debbonaire: That\u2019s the sort of economic growth you\u2019d get in the past under the Labour government in the UK",
   "type": "L"
  },
  {
   "nodeID": "75_168019561412742010",
   "text": "Amelie: Thangam Debbonaire: That\u2019s the sort of economic growth you\u2019d get in the past under the Labour government in the UK",
   "type": "L"
  },
  {
   "nodeID": "77_168019561412742010",
   "text": "the economic growth is what we\u2019re going to get in the future",
   "type": "I"
  },
  {
   "nodeID": "78_168019561412742010",
   "text": "Thangam Debbonaire: that\u2019s what we\u2019re going to get in the future",
   "type": "L"
  },
  {
   "nodeID": "80_168019561412742010",
   "text": "Amelie: Thangam Debbonaire: that\u2019s what we\u2019re going to get in the future",
   "type": "L"
  },
  {
   "nodeID": "82_168019561412742010",
   "text": "Thangam Debbonaire is glad Kier is ambitious",
   "type": "I"
  },
  {
   "nodeID": "83_168019561412742010",
   "text": "Thangam Debbonaire: I\u2019m glad Kier is ambitious",
   "type": "L"
  },
  {
   "nodeID": "85_168019561412742010",
   "text": "Amelie: Thangam Debbonaire: I\u2019m glad Kier is ambitious",
   "type": "L"
  },
  {
   "nodeID": "88_168019561412742010",
   "text": "political leaders being ambitious is what this country deserves",
   "type": "I"
  },
  {
   "nodeID": "89_168019561412742010",
   "text": "Thangam Debbonaire: that\u2019s what this country deserves",
   "type": "L"
  },
  {
   "nodeID": "91_168019561412742010",
   "text": "Amelie: Thangam Debbonaire: that\u2019s what this country deserves",
